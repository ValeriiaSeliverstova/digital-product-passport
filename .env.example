POSTGRES_DB=dpp
POSTGRES_USER=dpp_user
POSTGRES_PASSWORD=change_me
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# Generate a private value with: openssl rand -hex 32
JWT_SECRET_KEY=change_me
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_ISSUER=digital-product-passport-api
JWT_AUDIENCE=digital-product-passport-api

# Local Vite frontend allowed to call the backend from a browser
FRONTEND_ORIGIN=http://localhost:5173

# Server-side Cloudinary credentials; never expose the API secret to Vite
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
